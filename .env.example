# Copy to .env for local development. Replace every change-me placeholder locally.
RAGFLOW_AGENT_ENVIRONMENT=development

RAGFLOW_AGENT_API__HOST=0.0.0.0
RAGFLOW_AGENT_API__PORT=8000

RAGFLOW_AGENT_WORKER__POLL_INTERVAL_SECONDS=1
RAGFLOW_AGENT_WORKER__HEARTBEAT_INTERVAL_SECONDS=10
RAGFLOW_AGENT_WORKER__MAX_TRIES=6
RAGFLOW_AGENT_WORKER__JOB_TIMEOUT_SECONDS=300

RAGFLOW_AGENT_DATABASE__URL=postgresql+psycopg://ragflow_agent:change-me@localhost:5432/ragflow_agent
RAGFLOW_AGENT_DATABASE__POOL_SIZE=5
RAGFLOW_AGENT_DATABASE__MAX_OVERFLOW=10

RAGFLOW_AGENT_QUEUE__URL=redis://localhost:6379/0
RAGFLOW_AGENT_QUEUE__NAMESPACE=ragflow-agent
RAGFLOW_AGENT_QUEUE__QUEUE_NAME=arq:ragflow-agent:ingestion

RAGFLOW_AGENT_OBJECT_STORE__ENDPOINT_URL=http://localhost:9000
RAGFLOW_AGENT_OBJECT_STORE__BUCKET=ragflow-agent
RAGFLOW_AGENT_OBJECT_STORE__ACCESS_KEY=change-me
RAGFLOW_AGENT_OBJECT_STORE__SECRET_KEY=change-me
RAGFLOW_AGENT_OBJECT_STORE__SECURE=false

RAGFLOW_AGENT_SEARCH__BACKEND=elasticsearch
RAGFLOW_AGENT_SEARCH__URL=http://localhost:9200
RAGFLOW_AGENT_SEARCH__INDEX_NAME=ragflow-agent-chunks-v1
RAGFLOW_AGENT_SEARCH__VERIFY_CERTS=false

RAGFLOW_AGENT_MODELS__PROVIDER=openai-compatible
RAGFLOW_AGENT_MODELS__CHAT_MODEL=deepseek-chat
RAGFLOW_AGENT_MODELS__CHAT_BASE_URL=https://api.deepseek.com
# RAGFLOW_AGENT_MODELS__CHAT_API_KEY=set-only-in-local-secret-environment
RAGFLOW_AGENT_MODELS__EMBEDDING_MODEL=BAAI/bge-m3
RAGFLOW_AGENT_MODELS__EMBEDDING_BASE_URL=http://localhost:8080/v1
# RAGFLOW_AGENT_MODELS__EMBEDDING_API_KEY=set-only-if-the-local-endpoint-requires-it
RAGFLOW_AGENT_MODELS__EMBEDDING_DIMENSIONS=1024
RAGFLOW_AGENT_MODELS__RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAGFLOW_AGENT_MODELS__RERANKER_BASE_URL=
RAGFLOW_AGENT_MODELS__RERANKER_API_KEY=

# Phase 06 retrieval and content-minimized trace retention.
RAGFLOW_AGENT_RETRIEVAL__RRF_K=60
RAGFLOW_AGENT_RETRIEVAL__CANDIDATE_TOP_K=100
RAGFLOW_AGENT_RETRIEVAL__RERANK_CANDIDATE_COUNT=30
RAGFLOW_AGENT_RETRIEVAL__FINAL_TOP_K=10
RAGFLOW_AGENT_RETRIEVAL__FUSION_THRESHOLD=0
RAGFLOW_AGENT_RETRIEVAL__FALLBACK_THRESHOLD_FLOOR=0
RAGFLOW_AGENT_RETRIEVAL__MAX_FALLBACK_ATTEMPTS=4
RAGFLOW_AGENT_RETRIEVAL_TRACE__RETENTION_DAYS=30
RAGFLOW_AGENT_RETRIEVAL_TRACE__AGGREGATE_RETENTION_DAYS=180

# Phase 07 lifecycle, retry, outbox, retention, and batch policy.
RAGFLOW_AGENT_LIFECYCLE__MAX_ATTEMPTS=6
RAGFLOW_AGENT_LIFECYCLE__CONCURRENCY_ATTEMPTS=3
RAGFLOW_AGENT_LIFECYCLE__RETRY_BASE_SECONDS=1
RAGFLOW_AGENT_LIFECYCLE__RETRY_MAX_SECONDS=300
RAGFLOW_AGENT_LIFECYCLE__HISTORY_RETENTION_DAYS=30
RAGFLOW_AGENT_LIFECYCLE__SOFT_DELETE_RETENTION_DAYS=30
RAGFLOW_AGENT_LIFECYCLE__PREVIOUS_INDEX_RETENTION_DAYS=7
RAGFLOW_AGENT_LIFECYCLE__PURGE_COMPLETION_HOURS=24
RAGFLOW_AGENT_LIFECYCLE__OUTBOX_BATCH_SIZE=100
RAGFLOW_AGENT_LIFECYCLE__RECONCILE_BATCH_SIZE=100
RAGFLOW_AGENT_LIFECYCLE__BATCH_SIZE=100
RAGFLOW_AGENT_LIFECYCLE__BATCH_CONCURRENCY=2

# Phase 08 server-enforced Agentic RAG policy. Clients and models cannot raise
# these limits; production deployments may lower them through environment config.
RAGFLOW_AGENT_AGENTIC_RAG__MAX_AGENT_ITERATIONS=8
RAGFLOW_AGENT_AGENTIC_RAG__MAX_MODEL_CALLS=6
RAGFLOW_AGENT_AGENTIC_RAG__MAX_RETRIEVAL_ROUNDS=3
RAGFLOW_AGENT_AGENTIC_RAG__MAX_TOOL_ATTEMPTS=10
RAGFLOW_AGENT_AGENTIC_RAG__MAX_TOTAL_TOKENS=50000
RAGFLOW_AGENT_AGENTIC_RAG__MAX_GENERATED_TOKENS=8000
RAGFLOW_AGENT_AGENTIC_RAG__FINALIZATION_TOKEN_RESERVE=1500
RAGFLOW_AGENT_AGENTIC_RAG__MAX_ACTIVE_RUNTIME_SECONDS=120
RAGFLOW_AGENT_AGENTIC_RAG__MODEL_TIMEOUT_SECONDS=45
RAGFLOW_AGENT_AGENTIC_RAG__TOOL_TIMEOUT_SECONDS=15
RAGFLOW_AGENT_AGENTIC_RAG__MAX_KNOWN_COST_USD=0.50
# Set both rates to enforce the cost cap; omit both to record cost_status=unknown.
# RAGFLOW_AGENT_AGENTIC_RAG__MODEL_INPUT_COST_PER_MILLION_TOKENS_USD=
# RAGFLOW_AGENT_AGENTIC_RAG__MODEL_OUTPUT_COST_PER_MILLION_TOKENS_USD=
RAGFLOW_AGENT_AGENTIC_RAG__APPROVAL_TTL_MINUTES=30
RAGFLOW_AGENT_AGENTIC_RAG__MEMORY_TTL_DAYS=90
RAGFLOW_AGENT_AGENTIC_RAG__MEMORY_CLEANUP_HOURS=24
RAGFLOW_AGENT_AGENTIC_RAG__SQL_MAX_ROWS=200
RAGFLOW_AGENT_AGENTIC_RAG__SQL_TIMEOUT_SECONDS=5
RAGFLOW_AGENT_AGENTIC_RAG__API_CONNECT_TIMEOUT_SECONDS=5
RAGFLOW_AGENT_AGENTIC_RAG__API_READ_TIMEOUT_SECONDS=15
RAGFLOW_AGENT_AGENTIC_RAG__API_MAX_RESPONSE_BYTES=1000000
# Configure only with an independently managed read-only database account.
# RAGFLOW_AGENT_AGENTIC_RAG__SQL_DATABASE_URL=postgresql+psycopg://readonly:secret@localhost/business
RAGFLOW_AGENT_INGESTION__MAX_UPLOAD_BYTES=10485760
RAGFLOW_AGENT_INGESTION__CHUNK_MAX_TOKENS=384
RAGFLOW_AGENT_INGESTION__CHUNK_OVERLAP_TOKENS=48
RAGFLOW_AGENT_INGESTION__PARSER_TIMEOUT_SECONDS=30
RAGFLOW_AGENT_INGESTION__OCR_LANGUAGES=eng
# RAGFLOW_AGENT_INGESTION__TESSERACT_COMMAND=C:\Program Files\Tesseract-OCR\tesseract.exe
RAGFLOW_AGENT_INGESTION__OOXML_MAX_ENTRIES=5000
RAGFLOW_AGENT_INGESTION__OOXML_MAX_UNCOMPRESSED_BYTES=104857600
RAGFLOW_AGENT_INGESTION__OOXML_MAX_COMPRESSION_RATIO=100
RAGFLOW_AGENT_INGESTION__PDF_MAX_PAGES=2000
RAGFLOW_AGENT_INGESTION__IMAGE_MAX_PIXELS=40000000
RAGFLOW_AGENT_INGESTION__XLSX_MAX_SHEETS=64
RAGFLOW_AGENT_INGESTION__XLSX_MAX_ROWS_PER_SHEET=100000
RAGFLOW_AGENT_INGESTION__XLSX_MAX_NONEMPTY_CELLS=1000000
RAGFLOW_AGENT_OBSERVABILITY__LOG_LEVEL=INFO
RAGFLOW_AGENT_OBSERVABILITY__JSON_LOGS=true

# Docker Compose development-only credentials. Compose refuses to start while
# these remain unset; replace every placeholder in your untracked .env file.
RAGFLOW_AGENT_DEV_POSTGRES_PASSWORD=change-me
RAGFLOW_AGENT_DEV_MINIO_ROOT_USER=change-me
RAGFLOW_AGENT_DEV_MINIO_ROOT_PASSWORD=change-me

# Optional host-port overrides.
RAGFLOW_AGENT_DEV_POSTGRES_PORT=5432
RAGFLOW_AGENT_DEV_REDIS_PORT=6379
RAGFLOW_AGENT_DEV_MINIO_PORT=9000
RAGFLOW_AGENT_DEV_MINIO_CONSOLE_PORT=9001
RAGFLOW_AGENT_DEV_ELASTICSEARCH_PORT=9200
RAGFLOW_AGENT_DEV_API_PORT=8000
